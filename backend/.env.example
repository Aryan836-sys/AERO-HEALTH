DATABASE_URL=postgresql://postgres:your_password@localhost:5432/aerohealth
WAQI_TOKEN=your_waqi_token_here
OPENAQ_KEY=your_openaq_key_here
OWM_API_KEY=your_openweathermap_appid_here

# --- API (Backend Core) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
# Comma-separated frontend origins allowed by CORS. Use the real origin in production, never "*".
ALLOWED_ORIGINS=http://localhost:5173
# development | production   (production enables HSTS)
ENVIRONMENT=development
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
RATE_LIMIT_ENABLED=true
# Fetch fresh readings every 30 min while the API runs. Set false if you run
# `python -m app.jobs.cache_readings` as its own process instead.
CACHE_READINGS_ENABLED=true
# Cross-site frontend (different domain than the API)? set none (needs HTTPS). Default lax works for localhost.
COOKIE_SAMESITE=lax
