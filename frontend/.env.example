# Demo is the default. No API keys or backend are needed to explore the UI.
VITE_USE_MOCK_API=true
# Set to false (in .env.local) to use the real backend at VITE_API_BASE_URL.
VITE_API_BASE_URL=http://localhost:8000
# Optional: replace the default OpenStreetMap basemap with a provider approved for your deployment.
# (OSM's public tiles are fine for development and low traffic; use a hosted provider for production.)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Never put secret provider keys in VITE_* variables: these are public browser values.
