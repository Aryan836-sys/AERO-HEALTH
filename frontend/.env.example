# Demo is the default. No API keys or backend are needed to explore the UI.
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=http://localhost:8000
# Optional: replace the public CARTO basemap with a provider approved for your deployment.
VITE_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png
# Never put secret provider keys in VITE_* variables: these are public browser values.
